{
  "name": "pruaction-app",
  "version": "1.3.0",
  "private": true,
  "description": "PRUAction Performance module — Vite + React Router SPA (spec repo: pruaction-spec). BFF composition now lives in pa-be-dev.",
  "scripts": {
    "dev": "vite --port 3600",
    "dev:mock": "vite --port 3600 --mode mock",
    "build": "vite build",
    "start": "vite preview --port 3600",
    "test": "playwright test",
    "test:unit": "playwright test --config=playwright.unit.config.ts --project=unit",
    "test:e2e": "playwright test --project=e2e --project=desktop",
    "test:desktop": "playwright test --project=desktop",
    "test:mock": "playwright test --config=playwright.mock.config.ts",
    "test:headed": "playwright test --project=e2e --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "sync:specs": "bash scripts/sync-specs.sh",
    "assets:generate": "node scripts/generate-spec-assets.mjs",
    "assets:validate": "node scripts/validate-spec-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "pdfkit": "0.20.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@material-design-icons/svg": "^0.14.15",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "remixicon": "^4.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
