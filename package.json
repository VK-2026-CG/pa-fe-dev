{
  "name": "pruaction-app",
  "version": "1.3.0",
  "private": true,
  "description": "PRUAction Performance module — Next.js UI + BFF (spec repo: pruaction-spec)",
  "scripts": {
    "dev": "next dev -p 3600",
    "build": "next build",
    "start": "next start -p 3600",
    "test": "playwright test",
    "test:unit": "PW_SKIP_WEBSERVER=1 playwright test --project=unit",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e --project=desktop",
    "test:desktop": "playwright test --project=desktop",
    "test:headed": "playwright test --project=e2e --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "export:contests": "tsx scripts/export-imported-contests.ts",
    "sync:specs": "bash scripts/sync-specs.sh",
    "handoff:validate": "node scripts/validate-handoffs.mjs",
    "handoff:receipt": "node scripts/create-handoff-receipt.mjs",
    "assets:generate": "node scripts/generate-spec-assets.mjs",
    "assets:validate": "node scripts/validate-spec-assets.mjs"
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@material-design-icons/svg": "^0.14.15",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "remixicon": "^4.9.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
