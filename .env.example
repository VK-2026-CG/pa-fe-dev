# No setup needed for mock data: run `npm run dev:mock` here and in pa-be-dev.
# That profile (.env.mock) ignores this file's identity settings and serves stub
# data for every persona / scope / period, switchable from the header dropdown.

# Backend BFF origin (defaults to http://localhost:4600).
VITE_BFF_URL=http://localhost:4600

# Optional: force the x-persona header sent on every BFF call, overriding the
# header dropdown's stored localStorage selection. One of: LEADER_P2, LEADER_P3,
# AGENT_P4, AGENT_EMPTY, AGENT_PROCESSING (see src/lib/persona.ts). Only affects
# pa-be-dev's memory/fixture data source — ignored entirely when pa-be-dev runs
# with INSIGHTS_DATA_SOURCE=performance (that mode resolves persona from
# x-agent-id/VITE_PERFORMANCE_AGENT_ID instead).
# VITE_PERSONA=LEADER_P3

# Required only when pa-be-dev uses INSIGHTS_DATA_SOURCE=performance.
# Choose an ID from pa-be-dev's configured INSIGHTS_MOCK_AGENTS_FILE allowlist.
VITE_PERFORMANCE_AGENT_ID=1000073
VITE_PERFORMANCE_TENANT=MY

# Optional development-only source sample selector (ignored by production builds).
# JSON array of { id, kind: PRODUCTION|MAPA|PERSISTENCY, agentId }.
# Each agent must already be explicitly allowlisted by the backend.
# VITE_PERFORMANCE_MOCK_SAMPLES_FILE=data/performance-mocks/samples.json
