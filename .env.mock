# Committed profile for `npm run dev:mock` (vite --mode mock). Pair with
# pa-be-dev's `npm run dev:mock` (offline stub data, no Mongo).
# Vite gives `.env.mock` priority over `.env.local`, so these empty values
# neutralise any personal Mongo identity: persona comes from the header dropdown
# (x-persona), and the development sample picker stays off (mode is not
# `development`).

# Empty = same-origin; Vite proxies /api to http://127.0.0.1:4600.
VITE_BFF_URL=
VITE_PERSONA=
VITE_PERFORMANCE_AGENT_ID=
VITE_PERFORMANCE_MOCK_SAMPLES_FILE=
